# Build-time variables (Vite inlines them; redeploy after changing).

# Backend API base URL (include /api). Example placeholder:
VITE_API_URL=https://your-backend.example.com/api

# Public production domain used for WhatsApp share links, no trailing slash.
# Leave unset locally: links then use window.location.origin.
VITE_APP_BASE_URL=https://your-app.example.com
